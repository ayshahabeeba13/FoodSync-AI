# Environment Configuration Template for FoodSync AI
NODE_ENV=development
PORT=3000

# Authentication & Security
JWT_SECRET=your-secure-jwt-secret-key-min-32-chars
JWT_EXPIRES_IN=24h

# Demonstration Mode Safeguard
# WARNING: Must be 'false' in production. Setting to 'true' enables the one-click presentation role switcher.
DEMO_MODE=false

# Database Connection (Target: PostgreSQL 15+)
DATABASE_URL=postgresql://user:password@localhost:5432/foodsync_ai
