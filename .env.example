# =========================================================================
# FoodSync AI Environment Configuration Template
# =========================================================================

APP_NAME=FoodSync AI
ENVIRONMENT=production
DEBUG=False
PORT=8000
HOST=0.0.0.0

# Database Configuration (PostgreSQL 15+)
DATABASE_URL=postgresql://user:password@localhost:5432/foodsync_db

# Security & Authentication
JWT_SECRET=replace_with_a_cryptographically_secure_random_key_64_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Demonstration Mode (Set to False for Production Deployment)
DEMO_MODE=False

# Food Safety
REGULATORY_STANDARD=FSSAI_SURPLUS_2019
FSSAI_CHILLED_TEMP_MAX=5.0
FSSAI_HOT_HOLDING_TEMP_MIN=65.0
